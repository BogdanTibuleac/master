# Local container defaults. Copy to a git-ignored .env file if overrides are needed.
MALWARE_STORAGE_BACKEND=filesystem
MALWARE_ARTIFACT_DIR=/app/artifacts
MALWARE_SCAN_DIR=/app/data/scans
MALWARE_MODEL_CACHE_DIR=/tmp/malware-model-cache
MALWARE_MAX_UPLOAD_BYTES=26214400
MALWARE_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
