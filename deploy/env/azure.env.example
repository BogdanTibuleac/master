# Non-secret values injected by infra/main.bicep. Managed identity supplies credentials.
MALWARE_STORAGE_BACKEND=azure_blob
MALWARE_BLOB_ACCOUNT_URL=https://replace-me.blob.core.windows.net/
MALWARE_MODEL_CONTAINER=models
MALWARE_SCAN_CONTAINER=scan-metadata
MALWARE_MODEL_BLOB_PREFIX=releases/replace-with-model-version
MALWARE_MODEL_CACHE_DIR=/tmp/malware-model-cache
MALWARE_AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
MALWARE_MAX_UPLOAD_BYTES=26214400
MALWARE_CORS_ORIGINS=https://replace-with-frontend-host.example
